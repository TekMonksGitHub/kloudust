"form": {
    "description": "{{{i18n.K8sDescription}}}",

    "required_label": "{{{i18n.Required}}}",
    "required_fields": [
    {"id": "action", "multioption": true, "type": "select", "label": "{{{i18n.K8sAction}}}",
        "options": [
            {"value": "create", "label": "{{{i18n.K8sCreate}}}"},
            {"value": "addworkers", "label": "{{{i18n.K8sAddWorkers}}}"},
            {"value": "removeworkers", "label": "{{{i18n.K8sRemoveWorkers}}}"},
            {"value": "delete", "label": "{{{i18n.K8sDelete}}}"}
        ]},
    {"id": "clustername", "type": "text", "placeholder": "{{{i18n.K8sName}}}",
        "pattern": "[a-zA-Z0-9]{1,10}", "validation_error": "{{{i18n.FieldValidationErrorGeneric}}}"},
    {"id": "cluster", "multioption": true, "type": "select", "label": "{{{i18n.K8sCluster}}}", "options": []},
    {"id": "workers", "type": "number", "placeholder": "{{{i18n.K8sWorkersCreate}}}",
        "min": 1, "max": 10, "validation_error": "{{{i18n.FieldValidationErrorGeneric}}}"},
    {"id": "nodesize", "multioption": true, "type": "select", "label": "{{{i18n.K8sNodeSize}}}",
        "options": [
            {"value": "vsmall", "label": "{{{i18n.K8sVSmall}}}"},
            {"value": "small", "label": "{{{i18n.K8sSmall}}}"},
            {"value": "medium", "label": "{{{i18n.K8sMedium}}}"},
            {"value": "large", "label": "{{{i18n.K8sLarge}}}"}
        ]},
    {"id": "image", "multioption": true, "type": "select", "label": "{{{i18n.K8sImage}}}", "options": []},
    {"id": "adminid", "type": "text", "placeholder": "{{{i18n.K8sAdmin}}}",
        "pattern": "[a-z][a-z0-9_\\-]{0,31}", "validation_error": "{{{i18n.FieldValidationErrorGeneric}}}"},
    {"id": "adminpass", "type": "password", "placeholder": "{{{i18n.K8sAdminPass}}}",
        "pattern": "[A-Za-z0-9][A-Za-z0-9._+=@\\-]{7,}", "validation_error": "{{{i18n.FieldValidationErrorGeneric}}}"},
    {"id": "confirm", "type": "text", "placeholder": "{{{i18n.K8sConfirm}}}"}
    ],

    "load_javascript": [
    "const { cmdmanager } = await import(`${APP_CONSTANTS.LIB_PATH}/cmdmanager.mjs`);",
    "const form = arguments[0]||{};",
    "const imageField = form.required_fields.find(field => field.id == 'image');",
    "const clusterField = form.required_fields.find(field => field.id == 'cluster');",
    "const imagesResult = await cmdmanager.kdcmd('listVMImages', [], {}, undefined, true);",
    "const images = ((imagesResult && imagesResult.result) ? imagesResult.resources.concat(imagesResult.orgResources||[]) : []).filter(image => {",
    "    const [ostype, imgtype] = (image.extrainfo || '').toLowerCase().split(':');",
    "    return !ostype.startsWith('win') && !/windows/i.test(image.name + ' ' + (image.description || '')) && !imgtype?.endsWith('iso');",
    "});",
    "for (const image of images) imageField.options.push({value: image.name, label: image.description});",
    "if (!imageField.options.length) {",
    "    imageField.options.push({value: '', label: '{{{i18n.K8sNoImages}}}'});",
    "    imageField.disabled = true;",
    "}",
    "const project = $$.libsession.get(APP_CONSTANTS.ACTIVE_PROJECT);",
    "const vmsResult = await cmdmanager.kdcmd('listVMsForOrgOrProject', ['org', 'project', 'types'], {org: $$.libsession.get(APP_CONSTANTS.USERORG), project, types: APP_CONSTANTS.VM_TYPE_VM}, project, true);",
    "for (const vm of (vmsResult && vmsResult.vms) || []) {",
    "    let info = {}; try { info = JSON.parse(vm.extrainfo)?.k3s || {}; } catch (err) { info = {}; }",
    "    if (info.role == 'master') clusterField.options.push({value: info.cluster, label: info.cluster});",
    "}",
    "if (!clusterField.options.length) clusterField.options.push({value: '', label: '{{{i18n.K8sNoClusters}}}'});",
    "return form;"
    ],

    "rendered_javascript": [
    "const root = arguments[0]._form_shadowroot;",
    "const password = root.querySelector('input#adminpass');",
    "if (password) { password.setAttribute('autocomplete', 'new-password'); password.value = ''; }",
    "const action = root.querySelector('select#action'), workers = root.querySelector('input#workers');",
    "const shown = {create: ['clustername', 'workers', 'nodesize', 'image', 'adminid', 'adminpass'], addworkers: ['cluster', 'workers', 'adminpass'], removeworkers: ['cluster', 'workers'], delete: ['cluster', 'confirm']};",
    "const placeholders = {create: '{{{i18n.K8sWorkersCreate}}}', addworkers: '{{{i18n.K8sWorkersAdd}}}', removeworkers: '{{{i18n.K8sWorkersRemove}}}'};",
    "const required = {create: ['clustername', 'workers', 'adminid'], addworkers: ['cluster', 'workers'], removeworkers: ['cluster', 'workers'], delete: ['cluster', 'confirm']};",
    "const update = () => {",
    "    for (const id of ['clustername', 'cluster', 'workers', 'nodesize', 'image', 'adminid', 'adminpass', 'confirm']) {",
    "        const visible = shown[action.value].includes(id), field = root.querySelector('#' + id);",
    "        for (const element of root.querySelectorAll('#' + id + ', label[for=\"' + id + '\"]')) element.style.display = visible ? '' : 'none';",
    "        field.dataset.optional = visible ? 'false' : 'true';",
    "        field.required = visible && required[action.value].includes(id);",
    "        if (!visible && field.tagName != 'SELECT') { field.value = ''; field.setCustomValidity(''); }",
    "    }",
    "    workers.placeholder = placeholders[action.value] || '';",
    "};",
    "action.addEventListener('change', update);",
    "update();",
    "return true;"
    ],

    "submitlabel": "{{{i18n.K8sSubmit}}}"
}

}
