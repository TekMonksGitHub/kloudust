"tabledef": {
    "popupform": {
    "rolelist": {
        "*":[
            {"id": "getstatusvm", "label": "{{{i18n.VMSGetStatus}}}", "logo": "img/monitor.svg"},
            {"id": "firewallvm", "label": "{{{i18n.VMSFirewall}}}", "logo": "img/firewall.svg"},
            {"id": "assignipvm", "label": "{{{i18n.VMSAssignIP}}}", "logo": "img/assignipvm.svg"},
            {"id": "vnetvm", "label": "{{{i18n.VMSVNet}}}", "logo": "img/vnet.svg"},
            {"id": "poweropvm", "label": "{{{i18n.VMSPowerOpVM}}}", "logo": "img/poweropvm.svg"},
            {"id": "deletevm", "label": "{{{i18n.VMSDelete}}}", "logo": "img/deletevm.svg"},
            {"id": "resizevm", "label": "{{{i18n.VMSResize}}}", "logo": "img/resizevm.svg"},
            {"id": "snapshotvm", "label": "{{{i18n.VMSSnapshot}}}", "logo": "img/snapshot.svg"},
            {"id": "exportvm", "label": "{{{i18n.VMSExport}}}", "logo": "img/exportvm.svg"},
            {"id": "clonevm", "label": "{{{i18n.VMSClone}}}", "logo": "img/clonevm.svg"}
        ]
    }
    },

    "style": "div#tablebottombar{display: none;}",

    "i18nPrefix": "VMS",

    "enable_copy": true,

    "onclickrow_html": [
        "<style>div#onclick_html {background-color: #F8F8F8; width: auto;} div#close{display: none !important}</style>",
        "<style>div#onclickrow_html {height: fit-content;} div#body{background-color: #F8F8F8 !important}</style>",
        "<style>div#buttons {margin: 0 !important; align-items: flex-start !important; height: 100% !important;}</style>",
        "<style>div#button {height: unset !important; max-height: 100% !important; margin: 0 !important; color: #BC5205 !important;}</style>",
        "<style>div#button {width: 6em !important; font-size: 0.8em !important; box-sizing: border-box !important!;}</style>",
        "<style>div#button {border: 1px solid transparent; border-radius: 0.5em; padding: 0.5em;}</style>",
        "<style>div#button img {width: 3em !important; height: 3em !important;}</style>",
        "<style>div#button span {font-size: smaller !important; height: -webkit-fill-available;}</style>",
        "<style>div#button:hover {border: 1px dashed #BC5205 !important;}</style>",
        "<style>.vm-Booting div#button:not([onclick*=getstatusvm]), .vm-Unknown div#button:not([onclick*=getstatusvm]) {opacity: 0.4; pointer-events: none;}</style>",
        "<style>.vm-Running div#button[onclick*=getstatusvm], .vm-Stopped div#button[onclick*=getstatusvm] {display: none;}</style>"
    ],

    "clickrow_javascript": [
        "const data = arguments[0]; APP_CONSTANTS.ENV._vms_form_data = data;"
    ],

    "load_javascript": [
        "const { cmdmanager } = await import(`${APP_CONSTANTS.LIB_PATH}/cmdmanager.mjs`);",
        "const activeProject = $$.libsession.get(APP_CONSTANTS.ACTIVE_PROJECT);",
        "const vms = await cmdmanager.kdcmd('listVMsForOrgOrProject', ['org', 'project', 'types'], {org: $$.libsession.get(APP_CONSTANTS.USERORG), project: activeProject, types: APP_CONSTANTS.VM_TYPE_VM}, activeProject, true);",
        "for (const vm of vms.vms||[]) {",
        "   vm.datetime = new Date(vm.timestamp).toLocaleDateString(); vm.disk = parseInt(vm.disk)/1073741824; vm.memory=parseInt(vm.memory)/1048576;",
        "   vm.ips = vm.ips.trim()===''?'Not Assigned':vm.ips; vm.vnets = vm.vnets.length === 0 ?'No Vnets Found':vm.vnets.join(',');",
        "   vm.privateips = vm.private_ips.length === 0 ? 'No IPs Assigned' : vm.private_ips.join(','); ",
        "   vm.rulesets = vm.rulesets.length === 0 ? 'No Rulesets Applied' : vm.rulesets.join(',');",
        "}",
        "const modIconList = await import(`${APP_CONSTANTS.FORM_MODULES_PATH}/iconlist.mjs`), tabledef = arguments[0];",
        "const html = await modIconList.iconlist.getHTML(tabledef.popupform, monkshu_env.apps[APP_CONSTANTS.APP_NAME].cmdmanager);",
        "const tag = name => '{'+'{'+name+'}'+'}';  ",
        "tabledef.onclickrow_html.push(\"<div class='vm-\"+tag('powerstate')+\"'>\"+html+\"</div>\"); ",
        "const keys = ['name_raw','description','powerstate','ips','privateips','vnets','rulesets','os','disk','cpus','memory','datetime'];",
        "APP_CONSTANTS.ENV._vmsSetPowerState = (vm_name, powerstate) => {",
        "   const root = monkshu_env.components['table-list'].getShadowRootByHostId('vms');",
        "   for (const tr of root?.querySelectorAll('tbody tr')||[]) {",
        "       const rowB64 = tr.getAttribute('onclick')?.match(/'([^']+)'\\)/)?.[1]; if (!rowB64) continue;",
        "       const row = JSON.parse($$.libutil.base64ToString(rowB64)); if (row.name_raw != vm_name) continue;",
        "       row.powerstate = powerstate; tr.cells[keys.indexOf('powerstate')].textContent = powerstate;",
        "       tr.setAttribute('onclick', tr.getAttribute('onclick').replace(rowB64, $$.libutil.stringToBase64(JSON.stringify(row))));",
        "   }",
        "};",
        "return {keys, table: vms.vms||[]};"
    ]
}
}