{
"id": "getstatusvm",
"command": "getVMReadiness",
"type": "action",

"load_javascript": [
    "const { cmdmanager } = await import(`${APP_CONSTANTS.LIB_PATH}/cmdmanager.mjs`);",
    "const vm_name = APP_CONSTANTS.ENV._vms_form_data.name_raw, project = $$.libsession.get(APP_CONSTANTS.ACTIVE_PROJECT);",
    "monkshu_env.components['table-list'].getShadowRootByHostId('vms')?.querySelector('div#hider')?.click();   // close the popup",
    "const result = await cmdmanager.kdcmd('getVMReadiness', ['vm_name', 'max_wait'], {vm_name, max_wait: 10}, project);",
    "if (result.powerstate) APP_CONSTANTS.ENV._vmsSetPowerState(vm_name, result.powerstate);"
]
}
